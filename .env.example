# ===== C4Future Environment Variables =====
# Copy this file to `.env` and fill in your keys.
# Django auto-loads .env via python-dotenv (see carbon_project/settings.py).
# .env is in .gitignore — NEVER commit your real keys.

# --- Django ---
# Generate a new one for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-in-production
DJANGO_DEBUG=True

# --- LLM Provider ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Model name — gpt-4o-mini is fast + cheap; gpt-4o is smarter
ADVISOR_LLM_MODEL=gpt-4o-mini

# (Optional) Custom OpenAI-compatible base URL (e.g. Azure, Groq, Together,
# vLLM, Ollama). Leave blank to use api.openai.com.
OPENAI_BASE_URL=

# --- RAG config ---
# Embedding model — small + fast + free. Swap to bge-large for higher quality.
ADVISOR_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where ChromaDB persists vectors to disk
ADVISOR_CHROMA_DIR=./advisor/chroma_store

# Top-K chunks to retrieve per query
ADVISOR_TOP_K=4

# --- MLflow experiment tracking (training only) ---
# Set to a local path or remote server to log training runs.
#   Local:  MLFLOW_TRACKING_URI=./mlruns
#   Remote: MLFLOW_TRACKING_URI=http://localhost:5000
# Start the local UI with:  mlflow ui --backend-store-uri ./mlruns
# Leave blank to skip MLflow logging (safe default).
MLFLOW_TRACKING_URI=
